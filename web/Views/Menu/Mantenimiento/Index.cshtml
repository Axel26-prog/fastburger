@model IEnumerable<FastBurger.Application.DTOs.MenuDTO>

@{
    ViewData["Title"] = "Mantenimiento de Menús";
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-gear me-2"></i>Mantenimiento de Menús
                </h2>
                <p class="mb-0 invoice-subtitle">Administrar los menús del sistema</p>
            </div>
            <div class="text-end">
                <a asp-action="Crear" class="btn btn-fb">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Menú
                </a>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-book" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">No hay menús registrados</h4>
                <p class="text-muted mb-3">Comience creando el primer menú del sistema.</p>
                <a asp-action="Crear" class="btn btn-fb">
                    <i class="bi bi-plus-circle me-1"></i> Crear Primer Menú
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Listado de Menús (@Model.Count())</h5>
            </div>
            <div class="table-responsive">
                <table class="table invoice-table mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Horario</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var menu in Model)
                        {
                            <tr>
                                <td class="product-name">@menu.Nombre</td>
                                <td>@(menu.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@(menu.FechaFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@(menu.HoraInicio?.ToString(@"hh\:mm") ?? "—") - @(menu.HoraFin?.ToString(@"hh\:mm") ?? "—")</td>
                                <td>
                                    @if (menu.Activo)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i>Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Detalle" asp-route-id="@menu.IdMenu"
                                       class="btn btn-sm btn-outline-secondary me-1" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Modificar" asp-route-id="@menu.IdMenu"
                                       class="btn btn-sm btn-fb me-1" title="Modificar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@menu.IdMenu"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('¿Está seguro que desea eliminar este menú?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="invoice-footer mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
        </a>
    </div>
</div>