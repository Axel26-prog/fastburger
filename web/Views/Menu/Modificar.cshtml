@model FastBurger.Application.DTOs.MenuDTO

@{
    ViewData["Title"] = "Modificar Menú";
    var productos = ViewBag.Productos as IEnumerable<FastBurger.Application.DTOs.ProductoSimpleDTO>;
    var combos = ViewBag.Combos as IEnumerable<FastBurger.Application.DTOs.ComboSimpleDTO>;
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header" style="background-color:#3D2B1F; color:#fff;">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Modificar Menú</h4>
            </div>
            <div class="card-body">
                <form asp-action="Modificar" method="post" id="menuForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdMenu" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaInicio" class="form-label fw-semibold"></label>
                            <input asp-for="FechaInicio" class="form-control" type="date" />
                            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaFin" class="form-label fw-semibold"></label>
                            <input asp-for="FechaFin" class="form-control" type="date" />
                            <span asp-validation-for="FechaFin" class="text-danger small"></span>
                            @if (ViewData.ModelState.ContainsKey("FechaFin") && ViewData.ModelState["FechaFin"].Errors.Any())
                            {
                                <span class="text-danger small">@ViewData.ModelState["FechaFin"].Errors.First().ErrorMessage</span>
                            }
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraInicio" class="form-label fw-semibold"></label>
                            <input asp-for="HoraInicio" class="form-control" type="time" />
                            <span asp-validation-for="HoraInicio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraFin" class="form-label fw-semibold"></label>
                            <input asp-for="HoraFin" class="form-control" type="time" />
                            <span asp-validation-for="HoraFin" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiasSemana" class="form-label fw-semibold"></label>
                        <input asp-for="DiasSemana" class="form-control" placeholder="Ej: Lunes a Viernes" />
                        <span asp-validation-for="DiasSemana" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />
                    <h5 class="fw-bold mb-3" style="color:#3D2B1F;">Productos</h5>

                    <div class="mb-3">
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @if (productos != null && productos.Any())
                            {
                                @foreach (var prod in productos)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input producto-check" type="checkbox" 
                                               name="ProductoIds" value="@prod.IdProducto" 
                                               id="prod-@prod.IdProducto" 
                                               data-precio="@prod.Precio"
                                               onchange="togglePrecioProducto(@prod.IdProducto)" />
                                        <label class="form-check-label" for="prod-@prod.IdProducto">
                                            @prod.Nombre - <span class="text-muted">₡@prod.Precio.ToString("N2")</span>
                                        </label>
                                        <div class="mt-2 ms-4" id="precio-producto-@prod.IdProducto" style="display:none;">
                                            <label class="form-label small">Precio Especial (opcional)</label>
                                            <input type="number" class="form-control form-control-sm" 
                                                   name="PreciosProductos[@prod.IdProducto]" 
                                                   placeholder="@prod.Precio.ToString("N2")" step="0.01" min="0" />
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">No hay productos disponibles.</p>
                            }
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="fw-bold mb-3" style="color:#3D2B1F;">Combos</h5>

                    <div class="mb-3">
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @if (combos != null && combos.Any())
                            {
                                @foreach (var combo in combos)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input combo-check" type="checkbox" 
                                               name="ComboIds" value="@combo.IdCombo" 
                                               id="combo-@combo.IdCombo" 
                                               data-precio="@combo.Precio"
                                               onchange="togglePrecioCombo(@combo.IdCombo)" />
                                        <label class="form-check-label" for="combo-@combo.IdCombo">
                                            @combo.Nombre - <span class="text-muted">₡@combo.Precio.ToString("N2")</span>
                                        </label>
                                        <div class="mt-2 ms-4" id="precio-combo-@combo.IdCombo" style="display:none;">
                                            <label class="form-label small">Precio Especial (opcional)</label>
                                            <input type="number" class="form-control form-control-sm" 
                                                   name="PreciosCombos[@combo.IdCombo]" 
                                                   placeholder="@combo.Precio.ToString("N2")" step="0.01" min="0" />
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">No hay combos disponibles.</p>
                            }
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label fw-semibold"></label>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Mantenimiento" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                        <button type="submit" class="btn btn-fb">
                            <i class="bi bi-check-circle me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePrecioProducto(id) {
            var checkbox = document.getElementById('prod-' + id);
            var precioDiv = document.getElementById('precio-producto-' + id);
            if (checkbox.checked) {
                precioDiv.style.display = 'block';
            } else {
                precioDiv.style.display = 'none';
            }
        }

        function togglePrecioCombo(id) {
            var checkbox = document.getElementById('combo-' + id);
            var precioDiv = document.getElementById('precio-combo-' + id);
            if (checkbox.checked) {
                precioDiv.style.display = 'block';
            } else {
                precioDiv.style.display = 'none';
            }
        }
    </script>
}