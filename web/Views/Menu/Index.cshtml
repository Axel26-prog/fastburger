@model IEnumerable<FastBurger.Application.DTOs.MenuDTO>

@{
    ViewData["Title"] = "Menús";
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-book me-2"></i>Listado de Menús
                </h2>
                <p class="mb-0 invoice-subtitle">Todos los menús registrados, ordenados por fecha de disponibilidad</p>
            </div>
            <div class="text-end">
                <a asp-action="Disponible" class="btn btn-fb">
                    <i class="bi bi-eye me-1"></i> Ver Menú Disponible
                </a>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-book" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">No hay menús registrados</h4>
                <p class="text-muted mb-0">Aún no se han creado menús en el sistema.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-1">
            @foreach (var menu in Model)
            {
                <div class="col">
                    <div class="side-block h-100 card-fb" style="margin-bottom: 0;">
                        <div class="side-block-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-bookmark-fill me-1"></i>@menu.Nombre
                            </h6>
                            @if (menu.Activo)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i>Inactivo</span>
                            }
                        </div>
                        <div class="side-block-body">
                            @if (!string.IsNullOrEmpty(menu.Descripcion))
                            {
                                <p class="text-muted small mb-3">@menu.Descripcion</p>
                            }
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="info-label"><i class="bi bi-calendar-event me-1"></i>Inicio</div>
                                    <div class="info-value" style="font-size: 0.9rem;">@(menu.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")</div>
                                </div>
                                <div class="col-6">
                                    <div class="info-label"><i class="bi bi-calendar-check me-1"></i>Fin</div>
                                    <div class="info-value" style="font-size: 0.9rem;">@(menu.FechaFin?.ToString("dd/MM/yyyy") ?? "—")</div>
                                </div>
                                <div class="col-12">
                                    <div class="info-label"><i class="bi bi-clock me-1"></i>Horario</div>
                                    <div class="info-value" style="font-size: 0.9rem;">@(menu.HoraInicio?.ToString(@"hh\:mm") ?? "—") — @(menu.HoraFin?.ToString(@"hh\:mm") ?? "—")</div>
                                </div>
                                @if (!string.IsNullOrEmpty(menu.DiasSemana))
                                {
                                    <div class="col-12">
                                        <div class="info-label"><i class="bi bi-calendar-week me-1"></i>Días</div>
                                        <div class="info-value" style="font-size: 0.9rem;">@menu.DiasSemana</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>