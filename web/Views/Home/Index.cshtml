@{
    ViewData["Title"] = "Inicio";
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white text-center">
        <div class="py-3">
            <img src="~/images/LogoFastBurger.png" alt="FastBurger" class="mb-3" style="max-width:220px; background:#fff; border-radius:50%; padding:8px;" />
            <h1 class="display-4 fw-bold mb-2">FastBurger</h1>
            <p class="mb-0 invoice-subtitle">Las mejores hamburguesas, combos y menús al mejor precio</p>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-4">
            <div class="side-block h-100 text-center">
                <div class="side-block-body py-4">
                    <i class="bi bi-fire" style="font-size: 3rem; color: #E63946;"></i>
                    <h5 class="fw-bold mt-3 mb-1" style="color:#3D2B1F;">Combos Calientes</h5>
                    <p class="text-muted small mb-3">Variedad de combos al mejor precio, listos para retirar o enviar a domicilio.</p>
                </div>
                <div class="side-block-body" style="border-top: 1px solid #E6C9A8; background: #FFFAF3; padding: 0.85rem 1rem;">
                    <a asp-controller="Combo" asp-action="Index" class="btn btn-fb w-100">
                        <i class="bi bi-grid-3x3-gap me-1"></i> Ver Combos
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="side-block h-100 text-center">
                <div class="side-block-body py-4">
                    <i class="bi bi-card-list" style="font-size: 3rem; color: #E63946;"></i>
                    <h5 class="fw-bold mt-3 mb-1" style="color:#3D2B1F;">Menú del Día</h5>
                    <p class="text-muted small mb-3">Consulta los menús disponibles y conoce nuestra oferta vigente.</p>
                </div>
                <div class="side-block-body" style="border-top: 1px solid #E6C9A8; background: #FFFAF3; padding: 0.85rem 1rem;">
                    <a asp-controller="Menu" asp-action="Disponible" class="btn btn-fb w-100">
                        <i class="bi bi-book me-1"></i> Ver Menú Disponible
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="side-block h-100 text-center">
                <div class="side-block-body py-4">
                    <i class="bi bi-bag-check-fill" style="font-size: 3rem; color: #E63946;"></i>
                    <h5 class="fw-bold mt-3 mb-1" style="color:#3D2B1F;">Tu Pedido</h5>
                    <p class="text-muted small mb-3">Revisa tu carrito, completa el pago y recibe tu orden rápidamente.</p>
                </div>
                <div class="side-block-body" style="border-top: 1px solid #E6C9A8; background: #FFFAF3; padding: 0.85rem 1rem;">
                    <a asp-controller="Carrito" asp-action="Index" class="btn btn-fb w-100">
                        <i class="bi bi-cart me-1"></i> Mi Carrito
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>