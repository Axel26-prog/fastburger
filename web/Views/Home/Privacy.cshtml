@{
    ViewData["Title"] = "Política de Privacidad";
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <h1 class="mb-1 fw-bold"><i class="bi bi-shield-lock me-2"></i>Política de Privacidad</h1>
        <p class="mb-0 invoice-subtitle">FastBurger</p>
    </div>

    <div class="invoice-section mt-4">
        <div class="invoice-section-header">
            <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Aviso</h5>
        </div>
        <div class="invoice-section-body">
            <p class="mb-0">Use this page to detail your site's privacy policy.</p>
        </div>
    </div>

    <div class="invoice-footer mt-4">
        <a asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
        </a>
    </div>
</div>