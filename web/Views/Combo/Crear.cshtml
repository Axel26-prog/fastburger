@model FastBurger.Application.DTOs.CreateComboDTO

@{
    ViewData["Title"] = "Crear Combo";
    var productos = ViewBag.Productos as IEnumerable<FastBurger.Application.DTOs.ProductoSimpleDTO>;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <h2 class="mb-1 fw-bold">
            <i class="bi bi-plus-circle me-2"></i>Nuevo Combo
        </h2>
        <p class="mb-0 invoice-subtitle">Crear un nuevo combo en el catálogo</p>
    </div>

    <form asp-action="Crear" method="post" enctype="multipart/form-data" class="mt-4">
        @Html.AntiForgeryToken()

        <div class="invoice-section">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información del Combo</h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="Nombre" class="info-label"><i class="bi bi-tag me-1"></i>Nombre</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Precio" class="info-label"><i class="bi bi-currency-exchange me-1"></i>Precio</label>
                        <div class="input-group">
                            <span class="input-group-text">₡</span>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Productos incluidos</h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-2" style="max-height: 240px; overflow-y: auto;">
                    @if (productos != null)
                    {
                        @foreach (var prod in productos)
                        {
                            <div class="col-md-6">
                                <div class="form-check d-flex align-items-center p-2 rounded" style="background:#FFF8F0;">
                                    <input class="form-check-input me-2" type="checkbox"
                                           name="ProductoIds" value="@prod.IdProducto"
                                           id="prod-@prod.IdProducto" />
                                    <label class="form-check-label flex-grow-1" for="prod-@prod.IdProducto">
                                        @prod.Nombre
                                    </label>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-image me-2"></i>Imagen y Disponibilidad</h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="info-label"><i class="bi bi-image me-1"></i>Imagen del Combo</label>
                        <input type="file" name="Imagen" class="form-control" accept="image/*" />
                        <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Tamaño máximo: 2MB. Formatos: JPG, PNG, GIF</span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch">
                            <input asp-for="Disponible" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="Disponible" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="invoice-footer mt-4 d-flex justify-content-between flex-wrap gap-2">
            <a asp-action="Mantenimiento" class="btn btn-back">
                <i class="bi bi-arrow-left me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-fb-primary">
                <i class="bi bi-check-circle me-1"></i> Guardar Combo
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}