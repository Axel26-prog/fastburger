@model FastBurger.Application.DTOs.CreateComboDTO

@{
    ViewData["Title"] = "Crear Combo";
    var productos = ViewBag.Productos as IEnumerable<FastBurger.Application.DTOs.ProductoSimpleDTO>;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header" style="background-color:#3D2B1F; color:#fff;">
                <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Nuevo Combo</h4>
            </div>
            <div class="card-body">
                <form asp-action="Crear" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Precio" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">₡</span>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Productos incluidos</label>
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @if (productos != null)
                            {
                                @foreach (var prod in productos)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" 
                                               name="ProductoIds" value="@prod.IdProducto" 
                                               id="prod-@prod.IdProducto" />
                                        <label class="form-check-label" for="prod-@prod.IdProducto">
                                            @prod.Nombre
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Imagen del Combo</label>
                        <input type="file" name="Imagen" class="form-control" accept="image/*" />
                        <span class="text-muted small">Tamaño máximo: 2MB. Formatos: JPG, PNG, GIF</span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Disponible" class="form-check-input" />
                        <label asp-for="Disponible" class="form-check-label fw-semibold"></label>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Mantenimiento" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                        <button type="submit" class="btn btn-fb">
                            <i class="bi bi-check-circle me-1"></i> Guardar Combo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}