@model IEnumerable<FastBurger.Application.DTOs.ComboDTO>

@{
    ViewData["Title"] = "Combos";
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-grid-3x3-gap-fill me-2"></i>Catálogo de Combos
                </h2>
                <p class="mb-0 invoice-subtitle">Nuestra selección de combos disponibles</p>
            </div>
            <div class="text-end">
                <div class="invoice-number">@Model.Count() <small style="font-size: 0.6em; font-weight: 500;">combos</small></div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-box" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">No hay combos disponibles</h4>
                <p class="text-muted mb-0">Aún no se han registrado combos en el sistema.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-1">
            @foreach (var combo in Model)
            {
                <div class="col">
                    <div class="side-block h-100 card-fb" style="margin-bottom: 0;">
                        @if (!string.IsNullOrEmpty(combo.ImagenUrl))
                        {
                            <img src="@combo.ImagenUrl" class="img-fluid" alt="@combo.Nombre" style="height:200px; width:100%; object-fit:cover; border-radius:12px 12px 0 0;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center" style="height:200px; background:#f0f0f0; border-radius:12px 12px 0 0;">
                                <i class="bi bi-image" style="font-size: 3rem; color: #ccc;"></i>
                            </div>
                        }
                        <div class="side-block-body d-flex flex-column">
                            <h6 class="side-name mb-1">@combo.Nombre</h6>
                            <span class="badge mb-2 align-self-start" style="background:#F4A261; color:#3D2B1F;">
                                @combo.NombreCategoria
                            </span>
                            <p class="text-muted small mb-2"><i class="bi bi-box-seam me-1"></i>@combo.Productos.Count productos incluidos</p>
                            <p class="card-text fs-4 fw-bold mt-auto mb-2 text-end" style="color:#E63946;">₡@combo.Precio.ToString("N2")</p>
                            <div class="d-grid gap-2">
                                <a asp-action="Detalle" asp-route-id="@combo.IdCombo" class="btn btn-fb">
                                    <i class="bi bi-eye me-1"></i> Ver Detalle
                                </a>
                                @if (combo.Disponible)
                                {
                                    <button class="btn btn-fb-primary agregar-carrito" data-combo-id="@combo.IdCombo" data-nombre="@combo.Nombre">
                                        <span class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                                        <span class="btn-text"><i class="bi bi-cart-plus me-1"></i>Agregar al carrito</span>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled><i class="bi bi-x-circle me-1"></i>No disponible</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="carritoToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white">
            <i class="bi bi-check-circle-fill me-2"></i><strong class="me-auto">Carrito</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body" id="carritoToastBody">
            Combo agregado al carrito.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.agregar-carrito').on('click', function() {
                const btn = $(this);
                const comboId = btn.data('combo-id');
                const nombre = btn.data('nombre');

                btn.prop('disabled', true);
                btn.find('.spinner-border').removeClass('d-none');
                btn.find('.btn-text').text('Agregando...');

                $.ajax({
                    url: '/Carrito/Agregar',
                    type: 'POST',
                    data: {
                        idCombo: comboId,
                        cantidad: 1
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#carritoToastBody').text((response.item.nombreCombo || nombre) + ' agregado al carrito');
                            actualizarContadorCarrito();
                        } else {
                            $('#carritoToastBody').text(response.message);
                            $('.toast-header').removeClass('bg-success').addClass('bg-danger');
                        }
                        var toast = new bootstrap.Toast($('#carritoToast'));
                        toast.show();
                        $('.toast-header').removeClass('bg-danger').addClass('bg-success');
                    },
                    error: function() {
                        $('#carritoToastBody').text('Error al agregar al carrito');
                        $('.toast-header').removeClass('bg-success').addClass('bg-danger');
                        var toast = new bootstrap.Toast($('#carritoToast'));
                        toast.show();
                        $('.toast-header').removeClass('bg-danger').addClass('bg-success');
                    },
                    complete: function() {
                        btn.prop('disabled', false);
                        btn.find('.spinner-border').addClass('d-none');
                        btn.find('.btn-text').html('<i class="bi bi-cart-plus me-1"></i>Agregar al carrito');
                    }
                });
            });

            function actualizarContadorCarrito() {
                $.ajax({
                    url: '/Carrito/ObtenerContador',
                    type: 'GET',
                    success: function(response) {
                        const badge = $('#carritoContadorBadge');
                        if (response.totalItems > 0) {
                            badge.text(response.totalItems).removeClass('d-none');
                        } else {
                            badge.addClass('d-none');
                        }
                    }
                });
            }
        });
    </script>
}