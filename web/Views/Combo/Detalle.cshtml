@model FastBurger.Application.DTOs.ComboDTO

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-grid-3x3-gap-fill me-2"></i>@Model.Nombre
                </h2>
                <p class="mb-0 invoice-subtitle">Detalle del Combo</p>
            </div>
            <div class="text-end">
                <div class="invoice-number">₡@Model.Precio.ToString("N2")</div>
                <div class="mt-2">
                    @if (Model.Disponible)
                    {
                        <span class="badge estado-badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Disponible</span>
                    }
                    else
                    {
                        <span class="badge estado-badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>No disponible</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-5">
            <div class="invoice-section">
                <div class="invoice-section-body text-center p-3">
                    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                    {
                        <img src="@Model.ImagenUrl" alt="@Model.Nombre" class="img-fluid rounded" style="max-width:100%;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center" style="height:300px; background:#f0f0f0; border-radius:8px;">
                            <div>
                                <i class="bi bi-image" style="font-size: 4rem; color: #ccc;"></i>
                                <p class="text-muted mt-2 mb-0">Sin imagen disponible</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="invoice-section mb-3">
                <div class="invoice-section-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información</h5>
                </div>
                <div class="invoice-section-body">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <div class="info-label"><i class="bi bi-folder me-1"></i>Categoría</div>
                            <div class="info-value">@Model.NombreCategoria</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Descripcion))
                        {
                            <div class="col-12">
                                <div class="info-label"><i class="bi bi-card-text me-1"></i>Descripción</div>
                                <div class="info-value">@Model.Descripcion</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (Model.Productos.Any())
            {
                <div class="invoice-section">
                    <div class="invoice-section-header">
                        <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Productos incluidos</h5>
                    </div>
                    <div class="invoice-section-body">
                        <div class="row g-2">
                            @foreach (var producto in Model.Productos)
                            {
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center p-2 rounded" style="background:#FFF8F0;">
                                        <i class="bi bi-check-circle-fill me-2" style="color:#E63946;"></i>
                                        <span>@producto</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="invoice-footer mt-4">
        <a asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Volver a Combos
        </a>
    </div>
</div>