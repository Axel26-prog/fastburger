@using FastBurger.Application.DTOs
@{
    ViewData["Title"] = "Seleccionar Usuario";
    Layout = "_Layout";
    var usuarios = ViewBag.Usuarios as List<InfoUsuarioDTO>;
    var idActual = ViewBag.IdUsuarioActual as int?;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <h2 class="mb-1 fw-bold">
            <i class="bi bi-person-circle me-2"></i>Seleccionar Usuario
        </h2>
        <p class="mb-0 invoice-subtitle">Sesión simulada para evaluación</p>
    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-lg-6">
            <div class="invoice-section">
                <div class="invoice-section-body">
                    <form asp-action="Establecer" method="post">
                        @Html.AntiForgeryToken()
                        <select name="idUsuario" class="form-select form-select-lg" required onchange="this.form.submit()">
                            <option value="">-- Seleccione un usuario --</option>
                            @if (usuarios != null)
                            {
                                foreach (var u in usuarios)
                                {
                                    <option value="@u.IdUsuario" selected="@(idActual.HasValue && idActual.Value == u.IdUsuario)">
                                        @u.Nombre @u.Apellidos — @u.NombreRol
                                    </option>
                                }
                            }
                        </select>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>