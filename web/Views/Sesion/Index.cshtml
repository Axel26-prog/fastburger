@using FastBurger.Application.DTOs
@{
    ViewData["Title"] = "Seleccionar Usuario";
    Layout = "_Layout";
    var usuarios = ViewBag.Usuarios as List<InfoUsuarioDTO>;
    var idActual = ViewBag.IdUsuarioActual as int?;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-fb-primary text-white rounded-top-4 py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle me-2"></i>Seleccionar Usuario (Sesión Simulada)
                    </h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Este selector es temporal para fines de evaluación. Permite "loguearse"
                        como cualquier usuario existente sin requerir autenticación real.
                    </p>

                    @if (idActual.HasValue)
                    {
                        var actual = usuarios?.FirstOrDefault(u => u.IdUsuario == idActual.Value);
                        if (actual != null)
                        {
                            <div class="alert alert-success d-flex align-items-center" role="alert">
                                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                                <div>
                                    <strong>Sesión actual:</strong> @actual.Nombre @actual.Apellidos
                                    <span class="badge bg-secondary ms-1">@actual.NombreRol</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>No hay ningún usuario en sesión. Seleccione uno a continuación.</div>
                        </div>
                    }

                    <form asp-action="Establecer" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-bold">Usuario</label>
                            <select name="idUsuario" class="form-select form-select-lg" required>
                                <option value="">-- Seleccione un usuario --</option>
                                @if (usuarios != null)
                                {
                                    foreach (var u in usuarios)
                                    {
                                        <option value="@u.IdUsuario" selected="@(idActual.HasValue && idActual.Value == u.IdUsuario)">
                                            @u.Nombre @u.Apellidos — @u.NombreRol (@u.Correo)
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-fb-primary w-100 btn-lg">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Establecer como usuario actual
                        </button>
                    </form>

                    @if (idActual.HasValue)
                    {
                        <form asp-action="Cerrar" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión simulada
                            </button>
                        </form>
                    }

                    <hr class="my-4" />
                    <div class="d-grid gap-2">
                        <a asp-controller="Pedido" asp-action="Registrar" class="btn btn-outline-primary">
                            <i class="bi bi-cart-plus me-1"></i>Ir a Registrar Pedido
                        </a>
                        <a asp-controller="Pedido" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-list-ul me-1"></i>Ver Historial de Pedidos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
