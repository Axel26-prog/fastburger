@model FastBurger.Application.DTOs.ProductoDTO

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-box-seam me-2"></i>@Model.Nombre
                </h2>
                <p class="mb-0 invoice-subtitle">Detalle del Producto</p>
            </div>
            <div class="text-end">
                <div class="invoice-number">₡@Model.Precio.ToString("N2")</div>
                <div class="mt-2">
                    @if (Model.Disponible)
                    {
                        <span class="badge estado-badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Disponible</span>
                    }
                    else
                    {
                        <span class="badge estado-badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>No disponible</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-5">
            <div class="invoice-section">
                <div class="invoice-section-body text-center p-3">
                    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                    {
                        <img src="@Model.ImagenUrl" alt="@Model.Nombre" class="img-fluid rounded" style="max-width:100%;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center" style="height:300px; background:#f0f0f0; border-radius:8px;">
                            <div>
                                <i class="bi bi-image" style="font-size: 4rem; color: #ccc;"></i>
                                <p class="text-muted mt-2 mb-0">Sin imagen disponible</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="invoice-section mb-3">
                <div class="invoice-section-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información</h5>
                </div>
                <div class="invoice-section-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-label"><i class="bi bi-tag me-1"></i>Categoría</div>
                            <div class="info-value">@Model.NombreCategoria</div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-label"><i class="bi bi-clock me-1"></i>Tiempo de Prep.</div>
                            <div class="info-value">@Model.TiempoPrepMin min</div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-label"><i class="bi bi-fire me-1"></i>Calorías</div>
                            <div class="info-value">@(Model.Calorias?.ToString() ?? "—")</div>
                        </div>
                        <div class="col-12">
                            <div class="info-label"><i class="bi bi-card-text me-1"></i>Descripción</div>
                            <div class="info-value">@Model.Descripcion</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="invoice-section mb-3">
                <div class="invoice-section-header">
                    <h5 class="mb-0"><i class="bi bi-cart-plus me-2"></i>Agregar al Carrito</h5>
                </div>
                <div class="invoice-section-body">
                    <div class="row align-items-end g-2">
                        <div class="col-md-4">
                            <label class="info-label"><i class="bi bi-123 me-1"></i>Cantidad</label>
                            <input type="number" class="form-control" id="cantidadProducto" value="1" min="1" max="99" />
                        </div>
                        <div class="col-md-8">
                            @if (Model.Disponible)
                            {
                                <button class="btn btn-fb-primary btn-lg w-100 agregar-carrito-detalle" data-producto-id="@Model.IdProducto" data-nombre="@Model.Nombre">
                                    <span class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                                    <span class="btn-text"><i class="bi bi-cart-plus me-1"></i>Agregar al Carrito</span>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-lg w-100" disabled>
                                    <i class="bi bi-x-circle me-1"></i>No disponible
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Ingredientes.Any())
            {
                <div class="invoice-section">
                    <div class="invoice-section-header">
                        <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Ingredientes</h5>
                    </div>
                    <div class="invoice-section-body">
                        <div class="row g-2">
                            @foreach (var ingrediente in Model.Ingredientes)
                            {
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center p-2 rounded" style="background:#FFF8F0;">
                                        <i class="bi bi-check-circle-fill me-2" style="color:#E63946;"></i>
                                        <span>@ingrediente</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="invoice-footer mt-4">
        <a asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Volver a Productos
        </a>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="carritoToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white">
            <i class="bi bi-check-circle-fill me-2"></i><strong class="me-auto">Carrito</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body" id="carritoToastBody">
            Producto agregado al carrito.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.agregar-carrito-detalle').on('click', function() {
                const btn = $(this);
                const productoId = btn.data('producto-id');
                const nombre = btn.data('nombre');
                const cantidad = parseInt($('#cantidadProducto').val()) || 1;

                btn.prop('disabled', true);
                btn.find('.spinner-border').removeClass('d-none');
                btn.find('.btn-text').text('Agregando...');

                $.ajax({
                    url: '/Carrito/Agregar',
                    type: 'POST',
                    data: {
                        idProducto: productoId,
                        cantidad: cantidad
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#carritoToastBody').text(cantidad + ' x ' + nombre + ' agregado al carrito');
                            actualizarContadorCarrito();
                        } else {
                            $('#carritoToastBody').text(response.message);
                            $('.toast-header').removeClass('bg-success').addClass('bg-danger');
                        }
                        var toast = new bootstrap.Toast($('#carritoToast'));
                        toast.show();
                        $('.toast-header').removeClass('bg-danger').addClass('bg-success');
                    },
                    error: function() {
                        $('#carritoToastBody').text('Error al agregar al carrito');
                        $('.toast-header').removeClass('bg-success').addClass('bg-danger');
                        var toast = new bootstrap.Toast($('#carritoToast'));
                        toast.show();
                        $('.toast-header').removeClass('bg-danger').addClass('bg-success');
                    },
                    complete: function() {
                        btn.prop('disabled', false);
                        btn.find('.spinner-border').addClass('d-none');
                        btn.find('.btn-text').html('<i class="bi bi-cart-plus me-1"></i>Agregar al Carrito');
                    }
                });
            });

            function actualizarContadorCarrito() {
                $.ajax({
                    url: '/Carrito/ObtenerContador',
                    type: 'GET',
                    success: function(response) {
                        const badge = $('#carritoContadorBadge');
                        if (response.totalItems > 0) {
                            badge.text(response.totalItems).removeClass('d-none');
                        } else {
                            badge.addClass('d-none');
                        }
                    }
                });
            }
        });
    </script>
}