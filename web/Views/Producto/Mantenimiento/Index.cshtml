@model IEnumerable<FastBurger.Application.DTOs.ProductoDTO>

@{
    ViewData["Title"] = "Mantenimiento de Productos";
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-gear me-2"></i>Mantenimiento de Productos
                </h2>
                <p class="mb-0 invoice-subtitle">Administrar el catálogo de productos</p>
            </div>
            <div class="text-end">
                <a asp-action="Crear" class="btn btn-fb">
                    <i class="bi bi-plus-circle me-1"></i> Nuevo Producto
                </a>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-box" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">No hay productos registrados</h4>
                <p class="text-muted mb-3">Comience creando el primer producto del catálogo.</p>
                <a asp-action="Crear" class="btn btn-fb">
                    <i class="bi bi-plus-circle me-1"></i> Crear Primer Producto
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Listado de Productos (@Model.Count())</h5>
            </div>
            <div class="table-responsive">
                <table class="table invoice-table mb-0">
                    <thead>
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th class="text-end">Precio</th>
                            <th>Disponible</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                                    {
                                        <img src="@producto.ImagenUrl" alt="@producto.Nombre"
                                             class="rounded" style="width:60px; height:60px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                             style="width:60px; height:60px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td class="product-name">@producto.Nombre</td>
                                <td>
                                    <span class="badge" style="background-color:#F4A261; color:#3D2B1F;">
                                        @producto.NombreCategoria
                                    </span>
                                </td>
                                <td class="text-end fw-semibold">₡@producto.Precio.ToString("N2")</td>
                                <td>
                                    @if (producto.Disponible)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>No</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Detalle" asp-route-id="@producto.IdProducto"
                                       class="btn btn-sm btn-outline-secondary me-1" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Modificar" asp-route-id="@producto.IdProducto"
                                       class="btn btn-sm btn-fb me-1" title="Modificar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Eliminar" asp-route-id="@producto.IdProducto"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('¿Está seguro que desea eliminar este producto?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="invoice-footer mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
        </a>
    </div>
</div>