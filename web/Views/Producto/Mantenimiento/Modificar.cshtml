@model FastBurger.Application.DTOs.UpdateProductoDTO

@{
    ViewData["Title"] = "Modificar Producto";
    var categorias = ViewBag.Categorias as IEnumerable<FastBurger.Application.DTOs.CategoriaDTO>;
    var ingredientes = ViewBag.Ingredientes as IEnumerable<FastBurger.Application.DTOs.IngredienteDTO>;
    var ingredientesProducto = ViewBag.IngredientesProducto as List<int>;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <h2 class="mb-1 fw-bold">
            <i class="bi bi-pencil-square me-2"></i>Modificar Producto
        </h2>
        <p class="mb-0 invoice-subtitle">@Model.Nombre</p>
    </div>

    <form asp-action="Modificar" method="post" enctype="multipart/form-data" class="mt-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdProducto" />
        <input type="hidden" asp-for="ImagenUrlActual" />

        <div class="invoice-section">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información del Producto</h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="Nombre" class="info-label"><i class="bi bi-tag me-1"></i>Nombre</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="info-label"><i class="bi bi-card-text me-1"></i>Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IdCategoria" class="info-label"><i class="bi bi-folder me-1"></i>Categoría</label>
                        <select asp-for="IdCategoria" class="form-select">
                            <option value="">-- Seleccionar Categoría --</option>
                            @if (categorias != null)
                            {
                                @foreach (var cat in categorias)
                                {
                                    <option value="@cat.IdCategoria">@cat.Nombre</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Precio" class="info-label"><i class="bi bi-currency-exchange me-1"></i>Precio</label>
                        <div class="input-group">
                            <span class="input-group-text">₡</span>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Ingredientes</h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-2" style="max-height: 240px; overflow-y: auto;">
                    @if (ingredientes != null)
                    {
                        @foreach (var ing in ingredientes)
                        {
                            <div class="col-md-6">
                                <div class="form-check d-flex align-items-center p-2 rounded" style="background:#FFF8F0;">
                                    <input class="form-check-input me-2" type="checkbox"
                                           name="IngredienteIds" value="@ing.IdIngrediente"
                                           id="ing-@ing.IdIngrediente"
                                           @(ingredientesProducto != null && ingredientesProducto.Contains(ing.IdIngrediente) ? "checked" : "") />
                                    <label class="form-check-label flex-grow-1" for="ing-@ing.IdIngrediente">
                                        @ing.Nombre
                                        @if (ing.Alergenico)
                                        {
                                            <span class="badge bg-warning text-dark ms-1"><i class="bi bi-exclamation-triangle me-1"></i>Alérgeno</span>
                                        }
                                    </label>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-image me-2"></i>Imagen y Detalles Adicionales</h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="info-label"><i class="bi bi-image me-1"></i>Nueva Imagen</label>
                        <input type="file" name="Imagen" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ImagenUrlActual))
                        {
                            <div class="mt-2">
                                <p class="small text-muted mb-1">Imagen actual:</p>
                                <img src="@Model.ImagenUrlActual" alt="Imagen actual"
                                     class="rounded" style="max-height: 120px;" />
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TiempoPrepMin" class="info-label"><i class="bi bi-clock me-1"></i>Tiempo de Preparación (min)</label>
                        <input asp-for="TiempoPrepMin" class="form-control" type="number" min="1" />
                        <span asp-validation-for="TiempoPrepMin" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Calorias" class="info-label"><i class="bi bi-fire me-1"></i>Calorías</label>
                        <input asp-for="Calorias" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Calorias" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch">
                            <input asp-for="Disponible" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="Disponible" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="invoice-footer mt-4 d-flex justify-content-between flex-wrap gap-2">
            <a asp-action="Mantenimiento" class="btn btn-back">
                <i class="bi bi-arrow-left me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-fb-primary">
                <i class="bi bi-check-circle me-1"></i> Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}