@model FastBurger.Application.DTOs.UpdateProductoDTO

@{
    ViewData["Title"] = "Modificar Producto";
    var categorias = ViewBag.Categorias as IEnumerable<FastBurger.Application.DTOs.CategoriaDTO>;
    var ingredientes = ViewBag.Ingredientes as IEnumerable<FastBurger.Application.DTOs.IngredienteDTO>;
    var ingredientesProducto = ViewBag.IngredientesProducto as List<int>;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header" style="background-color:#3D2B1F; color:#fff;">
                <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Modificar Producto</h4>
            </div>
            <div class="card-body">
                <form asp-action="Modificar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdProducto" />
                    <input type="hidden" asp-for="ImagenUrlActual" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="IdCategoria" class="form-label fw-semibold"></label>
                            <select asp-for="IdCategoria" class="form-select">
                                <option value="">-- Seleccionar Categoría --</option>
                                @if (categorias != null)
                                {
                                    @foreach (var cat in categorias)
                                    {
                                        <option value="@cat.IdCategoria">@cat.Nombre</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ingredientes</label>
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @if (ingredientes != null)
                            {
                                @foreach (var ing in ingredientes)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="IngredienteIds" value="@ing.IdIngrediente"
                                               id="ing-@ing.IdIngrediente"
                                               @(ingredientesProducto != null && ingredientesProducto.Contains(ing.IdIngrediente) ? "checked" : "") />
                                        <label class="form-check-label" for="ing-@ing.IdIngrediente">
                                            @ing.Nombre
                                            @if (ing.Alergenico)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Alérgeno</span>
                                            }
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nueva Imagen</label>
                        <input type="file" name="Imagen" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ImagenUrlActual))
                        {
                            <div class="mt-2">
                                <p class="small text-muted mb-1">Imagen actual:</p>
                                <img src="@Model.ImagenUrlActual" alt="Imagen actual" 
                                     class="rounded" style="max-height: 120px;" />
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TiempoPrepMin" class="form-label fw-semibold"></label>
                            <input asp-for="TiempoPrepMin" class="form-control" type="number" min="1" />
                            <span asp-validation-for="TiempoPrepMin" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Calorias" class="form-label fw-semibold"></label>
                            <input asp-for="Calorias" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Calorias" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Disponible" class="form-check-input" />
                        <label asp-for="Disponible" class="form-check-label fw-semibold"></label>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Mantenimiento" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                        <button type="submit" class="btn btn-fb">
                            <i class="bi bi-check-circle me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}