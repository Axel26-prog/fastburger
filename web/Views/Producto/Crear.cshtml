@model FastBurger.Application.DTOs.CreateProductoDTO

@{
    ViewData["Title"] = "Crear Producto";
    var categorias = ViewBag.Categorias as IEnumerable<FastBurger.Application.DTOs.CategoriaDTO>;
    var ingredientes = ViewBag.Ingredientes as IEnumerable<FastBurger.Application.DTOs.IngredienteDTO>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold" style="color:#3D2B1F;">Crear Producto</h1>
    <a asp-action="Listar" class="btn btn-outline-secondary">← Volver</a>
</div>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Crear" method="post">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="IdCategoria" class="form-label fw-semibold">Categoría</label>
                            <select asp-for="IdCategoria" class="form-select">
                                <option value="">-- Seleccionar Categoría --</option>
                                @if (categorias != null)
                                {
                                    @foreach (var cat in categorias)
                                    {
                                        <option value="@cat.IdCategoria">@cat.Nombre</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImagenUrl" class="form-label fw-semibold">URL de Imagen</label>
                        <input asp-for="ImagenUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TiempoPrepMin" class="form-label fw-semibold">Tiempo de Preparación (min)</label>
                            <input asp-for="TiempoPrepMin" class="form-control" type="number" />
                            <span asp-validation-for="TiempoPrepMin" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Calorias" class="form-label fw-semibold">Calorías</label>
                            <input asp-for="Calorias" class="form-control" type="number" />
                            <span asp-validation-for="Calorias" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Disponible" class="form-check-input" />
                        <label asp-for="Disponible" class="form-check-label fw-semibold">Disponible</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ingredientes</label>
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @if (ingredientes != null)
                            {
                                @foreach (var ing in ingredientes)
                                {
                                    <div class="form-check">
                                        <input type="checkbox" 
                                               name="IngredientesIds" 
                                               value="@ing.IdIngrediente" 
                                               class="form-check-input"
                                               id="ing_@ing.IdIngrediente" />
                                        <label class="form-check-label" for="ing_@ing.IdIngrediente">
                                            @ing.Nombre
                                            @if (ing.Alergenico)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Alérgeno</span>
                                            }
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-fb w-100">Crear Producto</button>
                </div>
            </div>
        </form>
    </div>
</div>
