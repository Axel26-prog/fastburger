@model FastBurger.Application.DTOs.ResumenCarritoDTO?

@{
    ViewData["Title"] = "Mi Carrito";
    Layout = "_Layout";
    var info = ViewBag.UsuarioInfo as FastBurger.Application.DTOs.InfoUsuarioDTO;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-cart3 me-2"></i>Mi Carrito
                </h2>
                <p class="mb-0 invoice-subtitle">@(info != null ? $"{info.Nombre} {info.Apellidos}" : "—")</p>
            </div>
            <div class="text-end">
                @if (Model != null && Model.Items.Any())
                {
                    <div class="invoice-number">@Model.TotalItems <small style="font-size: 0.6em; font-weight: 500;">ítem@(Model.TotalItems == 1 ? "" : "s")</small></div>
                }
                else
                {
                    <div class="invoice-number">0 <small style="font-size: 0.6em; font-weight: 500;">ítems</small></div>
                }
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-cart-x" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">Tu carrito está vacío</h4>
                <p class="text-muted mb-4">Agrega productos del menú para empezar tu pedido.</p>
                <a asp-controller="Menu" asp-action="Disponible" class="btn btn-fb btn-lg">
                    <i class="bi bi-book me-1"></i> Ver Menú Disponible
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mt-1">
            <div class="col-lg-8">
                <div class="invoice-section">
                    <div class="invoice-section-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-bag me-2"></i>Productos en el Carrito
                        </h5>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="vaciarCarrito()">
                            <i class="bi bi-trash me-1"></i> Vaciar Carrito
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table invoice-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 45%">Producto / Combo</th>
                                    <th class="text-center" style="width: 20%">Cantidad</th>
                                    <th class="text-end" style="width: 15%">P. Unit.</th>
                                    <th class="text-end" style="width: 15%">Subtotal</th>
                                    <th style="width: 5%"></th>
                                </tr>
                            </thead>
                            <tbody id="carritoBody">
                                @foreach (var item in Model.Items)
                                {
                                    <tr data-item-id="@item.IdItem">
                                        <td>
                                            <div class="product-name">@(item.NombreProducto ?? item.NombreCombo)</div>
                                            @if (!string.IsNullOrEmpty(item.Notas))
                                            {
                                                <span class="obs-text"><i class="bi bi-chat-left-text me-1"></i>@item.Notas</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex align-items-center justify-content-center">
                                                <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="cambiarCantidad(@item.IdItem, -1)">−</button>
                                                <input type="number"
                                                       class="form-control form-control-sm text-center cantidad-input"
                                                       value="@item.Cantidad"
                                                       min="1" max="99"
                                                       style="width: 60px;"
                                                       onchange="actualizarCantidad(@item.IdItem, this.value)"
                                                       onclick="this.select();" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" onclick="cambiarCantidad(@item.IdItem, 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end">₡@item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end fw-semibold">₡@item.Subtotal.ToString("N2")</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarItem(@item.IdItem)" title="Eliminar">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="invoice-side">
                    <div class="totals-box">
                        <div class="totals-header">
                            <i class="bi bi-receipt me-2"></i>Resumen del Carrito
                        </div>
                        <div class="totals-body">
                            <div class="totals-row">
                                <span>Subtotal</span>
                                <span class="totals-amount" id="subtotalDisplay">₡@Model.Subtotal.ToString("N2")</span>
                            </div>
                            <div class="totals-row">
                                <span>Impuesto (13%)</span>
                                <span class="totals-amount" id="impuestoDisplay">₡@Model.Impuesto.ToString("N2")</span>
                            </div>
                            <div class="totals-divider"></div>
                            <div class="totals-row totals-grand">
                                <span>TOTAL</span>
                                <span id="totalDisplay">₡@Model.Total.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <a asp-controller="Pedido" asp-action="Registrar" class="btn btn-fb-primary w-100 btn-lg mt-3">
                        <i class="bi bi-arrow-right-circle me-1"></i> Proceder al Pago
                    </a>

                    <div class="side-block mt-3">
                        <div class="side-block-body text-center">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>Los precios incluyen el 13% de impuesto.<br />
                                Para delivery se agrega ₡500 de envío.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="invoice-footer mt-4">
        <a asp-controller="Menu" asp-action="Disponible" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Continuar Comprando
        </a>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="carritoToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white">
            <i class="bi bi-check-circle-fill me-2"></i><strong class="me-auto">Carrito</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body" id="carritoToastBody">
            Acción realizada.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const TASA_IMPUESTO = 0.13;
        let carritoData = @Html.Raw(Json.Serialize(Model));

        function mostrarToast(mensaje, esError = false) {
            $('#carritoToastBody').text(mensaje);
            $('.toast-header').removeClass('bg-success').addClass(esError ? 'bg-danger' : 'bg-success');
            var toast = new bootstrap.Toast($('#carritoToast'));
            toast.show();
        }

        function cambiarCantidad(itemId, delta) {
            const input = document.querySelector(`tr[data-item-id="${itemId}"] .cantidad-input`);
            let nuevaCantidad = parseInt(input.value) + delta;
            if (nuevaCantidad < 1) nuevaCantidad = 1;
            if (nuevaCantidad > 99) nuevaCantidad = 99;
            input.value = nuevaCantidad;
            actualizarCantidad(itemId, nuevaCantidad);
        }

        function actualizarCantidad(itemId, cantidad) {
            cantidad = parseInt(cantidad);
            if (cantidad <= 0) {
                eliminarItem(itemId);
                return;
            }

            $.ajax({
                url: '/Carrito/ActualizarCantidad',
                type: 'POST',
                data: { id: itemId, cantidad: cantidad },
                success: function(response) {
                    if (response.success) {
                        actualizarTotales();
                        mostrarToast('Cantidad actualizada');
                    } else {
                        mostrarToast(response.message || 'Error', true);
                    }
                },
                error: function() {
                    mostrarToast('Error al actualizar cantidad', true);
                }
            });
        }

        function eliminarItem(itemId) {
            if (!confirm('¿Eliminar este producto del carrito?')) return;

            $.ajax({
                url: '/Carrito/Eliminar',
                type: 'POST',
                data: { id: itemId },
                success: function(response) {
                    if (response.success) {
                        $(`tr[data-item-id="${itemId}"]`).remove();
                        actualizarTotales();

                        if ($('#carritoBody tr').length === 0) {
                            location.reload();
                        }
                        mostrarToast('Producto eliminado');
                        actualizarContadorCarrito();
                    } else {
                        mostrarToast('Error al eliminar', true);
                    }
                },
                error: function() {
                    mostrarToast('Error al eliminar', true);
                }
            });
        }

        function vaciarCarrito() {
            if (!confirm('¿Vaciar todo el carrito?')) return;

            $.ajax({
                url: '/Carrito/Vaciar',
                type: 'POST',
                success: function() {
                    location.reload();
                },
                error: function() {
                    mostrarToast('Error al vaciar carrito', true);
                }
            });
        }

        function actualizarTotales() {
            $.getJSON('/Carrito/ObtenerCarrito', function(response) {
                if (response.success && response.carrito) {
                    const carrito = response.carrito;
                    const subtotal = carrito.subtotal;
                    const impuesto = carrito.impuesto;
                    const total = carrito.total;

                    $('#subtotalDisplay').text('₡' + subtotal.toFixed(2));
                    $('#impuestoDisplay').text('₡' + impuesto.toFixed(2));
                    $('#totalDisplay').text('₡' + total.toFixed(2));
                }
            });
        }

        function actualizarContadorCarrito() {
            $.ajax({
                url: '/Carrito/ObtenerContador',
                type: 'GET',
                success: function(response) {
                    const badge = $('#carritoContadorBadge');
                    if (response.totalItems > 0) {
                        badge.text(response.totalItems).removeClass('d-none');
                    } else {
                        badge.addClass('d-none');
                    }
                }
            });
        }
    </script>
}