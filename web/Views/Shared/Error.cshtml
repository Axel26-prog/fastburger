@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white text-center">
        <i class="bi bi-exclamation-octagon-fill" style="font-size: 4rem;"></i>
        <h1 class="display-4 fw-bold mt-2 mb-1">Error</h1>
        <p class="mb-0 invoice-subtitle">Ha ocurrido un error al procesar la solicitud</p>
    </div>

    @if (Model.ShowRequestId)
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-fingerprint me-2"></i>Identificador de Solicitud</h5>
            </div>
            <div class="invoice-section-body">
                <code class="text-muted">@Model.RequestId</code>
            </div>
        </div>
    }

    <div class="invoice-section mt-4">
        <div class="invoice-section-header">
            <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Modo de Desarrollo</h5>
        </div>
        <div class="invoice-section-body">
            <p>
                Al habilitar el entorno <strong>Development</strong> se mostrará información más detallada sobre el error ocurrido.
            </p>
            <p>
                <strong>El entorno Development no debe estar habilitado en aplicaciones desplegadas en producción.</strong>
                Puede resultar en mostrar información sensible de excepciones a los usuarios finales.
                Para depuración local, habilite el entorno <strong>Development</strong> configurando la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> a <strong>Development</strong>
                y reiniciando la aplicación.
            </p>
        </div>
    </div>

    <div class="invoice-footer mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
        </a>
    </div>
</div>