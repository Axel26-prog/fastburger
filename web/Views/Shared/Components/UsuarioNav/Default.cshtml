@model bool

@if (Model)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownUsuario" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle"></i>
            @ViewBag.NombreCompleto
            <span class="badge bg-light text-dark ms-1">@ViewBag.Rol</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownUsuario">
            @if (ViewBag.EsAdmin)
            {
                <li>
                    <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-people me-2"></i>Gestión de Usuarios
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
            <li>
                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Cuenta" asp-action="Login">
            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
        </a>
    </li>
}