@model IEnumerable<FastBurger.Application.DTOs.OrdenCocinaListaDTO>

@{
    ViewData["Title"] = "Cocina";
    var info = ViewBag.UsuarioInfo as FastBurger.Application.DTOs.InfoUsuarioDTO;
    var enEspera = Model.Where(o => o.Estado == "en_espera").ToList();
    var enProceso = Model.Where(o => o.Estado == "en_proceso").ToList();
    var totalActivas = enEspera.Count + enProceso.Count;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap mb-3">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-fire me-2"></i>FastBurger · Cocina
                </h2>
                <p class="mb-0 invoice-subtitle">Tablero de Órdenes en Cocina</p>
            </div>
            <div class="text-end">
                <div class="invoice-number">@totalActivas <small style="font-size: 0.6em; font-weight: 500;">órdenes activas</small></div>
                <div class="invoice-date">
                    <i class="bi bi-person-circle me-1"></i>@(info?.NombreRol ?? "—") · @(info != null ? $"{info.Nombre} {info.Apellidos}" : "—")
                </div>
                <div class="mt-2 d-flex gap-2 justify-content-end flex-wrap">
                    <span class="badge estado-badge bg-warning text-dark fs-6">
                        <i class="bi bi-hourglass-split me-1"></i>En espera: @enEspera.Count
                    </span>
                    <span class="badge estado-badge bg-info text-dark fs-6">
                        <i class="bi bi-fire me-1"></i>En proceso: @enProceso.Count
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (!enEspera.Any() && !enProceso.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-check-circle" style="font-size: 4rem; color: #81C784;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">No hay órdenes pendientes</h4>
                <p class="text-muted mb-0">Todas las órdenes de cocina están al día.</p>
            </div>
        </div>
    }

    @if (enEspera.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0">
                    <i class="bi bi-hourglass-split me-2"></i>En Espera <span class="badge bg-warning text-dark ms-2">@enEspera.Count</span>
                </h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-3">
                    @foreach (var orden in enEspera)
                    {
                        <div class="col-md-6 col-lg-4">
                            @await Html.PartialAsync("_OrdenCard", orden, new ViewDataDictionary(ViewData) { { "Accion", "Iniciar" }, { "AccionTexto", "Iniciar preparación" }, { "AccionClase", "btn-fb-primary" }, { "AccionIcono", "bi-play-circle-fill" } })
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (enProceso.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0">
                    <i class="bi bi-fire me-2"></i>En Preparación <span class="badge bg-info text-dark ms-2">@enProceso.Count</span>
                </h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-3">
                    @foreach (var orden in enProceso)
                    {
                        <div class="col-md-6 col-lg-4">
                            @await Html.PartialAsync("_OrdenCard", orden, new ViewDataDictionary(ViewData) { { "Accion", "MarcarLista" }, { "AccionTexto", "Marcar como lista" }, { "AccionClase", "btn-fb" }, { "AccionIcono", "bi-check2-circle" } })
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>