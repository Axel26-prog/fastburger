@model FastBurger.Application.DTOs.OrdenCocinaListaDTO

@{
    var accion = ViewData["Accion"]?.ToString() ?? "Iniciar";
    var accionTexto = ViewData["AccionTexto"]?.ToString() ?? "Iniciar preparación";
    var accionClase = ViewData["AccionClase"]?.ToString() ?? "btn-fb-primary";
    var accionIcono = ViewData["AccionIcono"]?.ToString() ?? "bi-play-circle-fill";
    var tiempoLabel = Model.Estado == "en_proceso" ? "Preparando" : "Espera";
    var tiempoValor = Model.Estado == "en_proceso" ? Model.TiempoPreparacionMin : Model.TiempoEsperaMin;
    var estadoIcono = Model.Estado == "en_proceso" ? "bi-fire" : "bi-hourglass-split";
    var estadoTexto = Model.Estado == "en_proceso" ? "En proceso" : "En espera";
    var totalItems = Model.Items.Sum(i => i.Cantidad);
}

<div class="side-block h-100" style="margin-bottom: 0;">
    <div class="side-block-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi @estadoIcono me-2"></i>Pedido <strong>#@Model.IdPedido</strong>
        </span>
        <span class="badge @(Model.Estado == "en_proceso" ? "bg-info text-dark" : "bg-warning text-dark")">
            <i class="bi @estadoIcono me-1"></i>@estadoTexto
        </span>
    </div>
    <div class="side-block-body">
        <div class="row g-2 mb-3">
            <div class="col-7">
                <div class="info-label"><i class="bi bi-person me-1"></i>Cliente</div>
                <div class="side-name" style="font-size: 0.95rem;">@Model.NombreCliente</div>
            </div>
            <div class="col-5">
                <div class="info-label"><i class="bi bi-broadcast me-1"></i>Estación</div>
                <div class="info-value" style="font-size: 0.9rem;">@(string.IsNullOrEmpty(Model.NombreEstacion) ? "—" : Model.NombreEstacion)</div>
            </div>
            <div class="col-6">
                <div class="info-label"><i class="bi bi-clock-history me-1"></i>@tiempoLabel</div>
                <div class="info-value" style="font-size: 0.9rem;">@tiempoValor min</div>
            </div>
            <div class="col-6">
                <div class="info-label"><i class="bi bi-box-seam me-1"></i>Items</div>
                <div class="info-value" style="font-size: 0.9rem;">@totalItems unidad@(totalItems == 1 ? "" : "es")</div>
            </div>
        </div>

        <div class="info-label mb-1">
            <i class="bi bi-list-ul me-1"></i>Detalle de la Orden
        </div>
        <div class="table-responsive">
            <table class="table invoice-table mb-0" style="font-size: 0.88rem;">
                <thead>
                    <tr>
                        <th style="padding: 0.5rem;">Producto / Combo</th>
                        <th class="text-center" style="width: 70px; padding: 0.5rem;">Cant.</th>
                        <th style="width: 90px; padding: 0.5rem;">Notas</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="padding: 0.55rem 0.5rem;">
                                <div class="product-name" style="font-size: 0.88rem;">@(item.NombreProducto ?? item.NombreCombo ?? "Ítem")</div>
                            </td>
                            <td class="text-center" style="padding: 0.55rem 0.5rem;">
                                <span class="qty-badge" style="font-size: 0.8rem;">@item.Cantidad</span>
                            </td>
                            <td style="padding: 0.55rem 0.5rem;">
                                @if (!string.IsNullOrEmpty(item.Notas))
                                {
                                    <span class="obs-text" style="font-size: 0.78rem;">
                                        <i class="bi bi-chat-left-text me-1"></i>@item.Notas
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 d-flex justify-content-between align-items-center" style="font-size: 0.78rem; color: #8B6F4A;">
            <span><i class="bi bi-calendar3 me-1"></i>Ingresó: @Model.FechaIngreso.ToString("HH:mm")</span>
            @if (Model.FechaInicio.HasValue)
            {
                <span><i class="bi bi-play-fill me-1"></i>Inició: @Model.FechaInicio.Value.ToString("HH:mm")</span>
            }
        </div>
    </div>
    <div class="side-block-body" style="border-top: 1px solid #E6C9A8; background: #FFFAF3; padding: 0.85rem 1rem;">
        <form asp-action="@accion" asp-route-id="@Model.IdOrdenCocina" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn @accionClase w-100">
                <i class="bi @accionIcono me-1"></i>@accionTexto
            </button>
        </form>
    </div>
</div>