@model IEnumerable<FastBurger.Application.DTOs.ProcesoPreparacionDTO>

@{
    ViewData["Title"] = "Procesos de Preparación";
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-diagram-3 me-2"></i>Procesos de Preparación
                </h2>
                <p class="mb-0 invoice-subtitle">Recetas y pasos por producto</p>
            </div>
            <div class="text-end">
                <div class="invoice-number">@Model.Count() <small style="font-size: 0.6em; font-weight: 500;">procesos</small></div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-diagram-3" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">No hay procesos registrados</h4>
                <p class="text-muted mb-0">Aún no se han definido procesos de preparación.</p>
            </div>
        </div>
    }
    else
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Listado de Procesos</h5>
            </div>
            <div class="table-responsive">
                <table class="table invoice-table mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Pasos</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proceso in Model)
                        {
                            <tr>
                                <td class="product-name">@proceso.NombreProducto</td>
                                <td class="text-center">
                                    <span class="qty-badge" style="background:#E63946;">@proceso.CantidadPasos</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detalle" asp-route-id="@proceso.IdProceso" class="btn btn-sm btn-fb">
                                        <i class="bi bi-eye me-1"></i>Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>