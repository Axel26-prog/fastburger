@model FastBurger.Application.DTOs.ProcesoPreparacionDTO

@{
    ViewData["Title"] = "Proceso — " + Model.NombreProducto;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-diagram-3 me-2"></i>Proceso de Preparación
                </h2>
                <p class="mb-0 invoice-subtitle">@Model.NombreProducto</p>
            </div>
            <div class="text-end">
                <div class="invoice-number">@Model.CantidadPasos <small style="font-size: 0.6em; font-weight: 500;">pasos</small></div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Descripcion))
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-card-text me-2"></i>Descripción</h5>
            </div>
            <div class="invoice-section-body">
                <p class="mb-0">@Model.Descripcion</p>
            </div>
        </div>
    }

    @if (Model.Pasos.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-ol me-2"></i>Pasos del Proceso</h5>
            </div>
            <div class="invoice-section-body">
                <div class="timeline-fb">
                    @foreach (var paso in Model.Pasos.OrderBy(p => p.Orden))
                    {
                        <div class="timeline-step">
                            <div class="timeline-number">@paso.Orden</div>
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="mb-1 fw-bold" style="color:#3D2B1F;">@paso.NombreEstacion</h5>
                                    <div class="text-muted small">
                                        @if (paso.TiempoMin > 0)
                                        {
                                            <span class="me-3"><i class="bi bi-clock"></i> @paso.TiempoMin min</span>
                                        }
                                        @if (paso.TemperaturaC.HasValue)
                                        {
                                            <span><i class="bi bi-thermometer-half"></i> @paso.TemperaturaC.Value°C</span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(paso.Descripcion))
                                {
                                    <p class="mb-0 text-muted">@paso.Descripcion</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-4">
                <i class="bi bi-info-circle" style="font-size: 2rem; color: #ccc;"></i>
                <p class="text-muted mt-2 mb-0">Este proceso no tiene pasos definidos.</p>
            </div>
        </div>
    }

    <div class="invoice-footer mt-4">
        <a asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Volver a Procesos
        </a>
    </div>
</div>