@model FastBurger.Application.DTOs.UpdateProcesoPreparacionDTO

@{
    ViewData["Title"] = "Modificar Proceso de Preparación";
    var productos = ViewBag.Productos as IEnumerable<FastBurger.Application.DTOs.ProductoSimpleDTO>;
    var estaciones = ViewBag.Estaciones as IEnumerable<FastBurger.Application.DTOs.EstacionSimpleDTO>;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <h2 class="mb-1 fw-bold">
            <i class="bi bi-pencil-square me-2"></i>Modificar Proceso de Preparación
        </h2>
        <p class="mb-0 invoice-subtitle">@Model.NombreProducto</p>
    </div>

    <form asp-action="Modificar" method="post" id="procesoForm" class="mt-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdProceso" />

        <div class="invoice-section">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Información del Proceso</h5>
            </div>
            <div class="invoice-section-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="info-label"><i class="bi bi-box-seam me-1"></i>Producto</label>
                        <input type="hidden" asp-for="IdProducto" />
                        <input type="text" class="form-control" value="@Model.NombreProducto" readonly />
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="info-label"><i class="bi bi-card-text me-1"></i>Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="invoice-section mt-4">
            <div class="invoice-section-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ol me-2"></i>Pasos del Proceso</h5>
                <button type="button" class="btn btn-sm btn-fb" onclick="agregarPaso()">
                    <i class="bi bi-plus-circle me-1"></i> Agregar Paso
                </button>
            </div>
            <div class="invoice-section-body">
                <div id="pasosContainer"></div>
            </div>
        </div>

        <div class="invoice-footer mt-4 d-flex justify-content-between flex-wrap gap-2">
            <a asp-action="Mantenimiento" class="btn btn-back">
                <i class="bi bi-arrow-left me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-fb-primary">
                <i class="bi bi-check-circle me-1"></i> Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let pasoIndex = 0;

        const pasosIniciales = @Html.Raw(Json.Serialize(Model.Pasos));

        function agregarPaso() {
            const container = document.getElementById('pasosContainer');
            const estaciones = @Html.Raw(Json.Serialize(estaciones));

            let opcionesEstaciones = '<option value="">-- Estación --</option>';
            estaciones.forEach(function(est) {
                opcionesEstaciones += `<option value="${est.idEstacion}">${est.nombre}</option>`;
            });

            const pasoHtml = `
                <div class="side-block mb-3 paso-item" data-paso-index="${pasoIndex}">
                    <div class="side-block-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-arrow-right-circle me-2"></i>Paso <span class="paso-numero">${pasoIndex + 1}</span></h6>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarPaso(${pasoIndex})">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                    <div class="side-block-body">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="info-label">Orden</label>
                                <input type="number" class="form-control" name="Pasos[${pasoIndex}].Orden" value="${pasoIndex + 1}" min="1" required />
                            </div>
                            <div class="col-md-5">
                                <label class="info-label">Estación</label>
                                <select class="form-select" name="Pasos[${pasoIndex}].IdEstacion" required>
                                    ${opcionesEstaciones}
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="info-label">Tiempo (min)</label>
                                <input type="number" class="form-control" name="Pasos[${pasoIndex}].TiempoMin" value="5" min="1" required />
                            </div>
                            <div class="col-md-6">
                                <label class="info-label">Descripción</label>
                                <input type="text" class="form-control" name="Pasos[${pasoIndex}].Descripcion" placeholder="Ej: Freír la carne" required />
                            </div>
                            <div class="col-md-6">
                                <label class="info-label">Temperatura (°C) - Opcional</label>
                                <input type="number" class="form-control" name="Pasos[${pasoIndex}].TemperaturaC" placeholder="Ej: 180" />
                            </div>
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', pasoHtml);
            pasoIndex++;
            actualizarNumerosPasos();
        }

        function eliminarPaso(index) {
            const paso = document.querySelector(`.paso-item[data-paso-index="${index}"]`);
            if (paso) {
                paso.remove();
                actualizarNumerosPasos();
            }
        }

        function actualizarNumerosPasos() {
            const pasos = document.querySelectorAll('.paso-item');
            pasos.forEach((paso, idx) => {
                paso.querySelector('.paso-numero').textContent = idx + 1;
                paso.querySelectorAll('input, select').forEach(input => {
                    if (input.name) {
                        input.name = input.name.replace(/Pasos\[\d+\]/g, `Pasos[${idx}]`);
                    }
                });
            });
            pasoIndex = pasos.length;
        }

        if (pasosIniciales && pasosIniciales.length > 0) {
            pasosIniciales.forEach(function(paso) {
                const container = document.getElementById('pasosContainer');
                const estaciones = @Html.Raw(Json.Serialize(estaciones));

                let opcionesEstaciones = '<option value="">-- Estación --</option>';
                estaciones.forEach(function(est) {
                    const selected = est.idEstacion === paso.idEstacion ? 'selected' : '';
                    opcionesEstaciones += `<option value="${est.idEstacion}" ${selected}>${est.nombre}</option>`;
                });

                const pasoHtml = `
                    <div class="side-block mb-3 paso-item" data-paso-index="${pasoIndex}">
                        <div class="side-block-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-arrow-right-circle me-2"></i>Paso <span class="paso-numero">${pasoIndex + 1}</span></h6>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarPaso(${pasoIndex})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        <div class="side-block-body">
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="info-label">Orden</label>
                                    <input type="number" class="form-control" name="Pasos[${pasoIndex}].Orden" value="${paso.orden}" min="1" required />
                                </div>
                                <div class="col-md-5">
                                    <label class="info-label">Estación</label>
                                    <select class="form-select" name="Pasos[${pasoIndex}].IdEstacion" required>
                                        ${opcionesEstaciones}
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="info-label">Tiempo (min)</label>
                                    <input type="number" class="form-control" name="Pasos[${pasoIndex}].TiempoMin" value="${paso.tiempoMin}" min="1" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="info-label">Descripción</label>
                                    <input type="text" class="form-control" name="Pasos[${pasoIndex}].Descripcion" value="${paso.descripcion || ''}" placeholder="Ej: Freír la carne" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="info-label">Temperatura (°C) - Opcional</label>
                                    <input type="number" class="form-control" name="Pasos[${pasoIndex}].TemperaturaC" value="${paso.temperaturaC || ''}" placeholder="Ej: 180" />
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', pasoHtml);
                pasoIndex++;
            });
        } else {
            agregarPaso();
        }
    </script>
}