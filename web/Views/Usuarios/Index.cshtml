@model IEnumerable<FastBurger.Application.DTOs.UsuarioListaDTO>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-people me-2"></i>Gestión de Usuarios
                </h2>
                <p class="mb-0 invoice-subtitle">Administrar usuarios del sistema</p>
            </div>
            <div class="text-end">
                <a asp-action="Crear" class="btn btn-fb">
                    <i class="bi bi-person-plus me-1"></i> Nuevo Usuario
                </a>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-people" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">No hay usuarios registrados</h4>
            </div>
        </div>
    }
    else
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Listado de Usuarios (@Model.Count())</h5>
            </div>
            <div class="table-responsive">
                <table class="table invoice-table mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Último acceso</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="product-name">@u.NombreCompleto</td>
                                <td>@u.Correo</td>
                                <td>@(u.Telefono ?? "-")</td>
                                <td>
                                    <span class="badge" style="background-color:#F4A261; color:#3D2B1F;">
                                        @u.NombreRol
                                    </span>
                                </td>
                                <td>
                                    @if (u.Activo)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Inactivo</span>
                                    }
                                </td>
                                <td>
                                    @if (u.UltimoAcceso.HasValue)
                                    {
                                        @u.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Nunca</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="ResetPassword" asp-route-id="@u.IdUsuario"
                                       class="btn btn-sm btn-outline-secondary me-1" title="Resetear contraseña">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    @if (u.Activo)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@u.IdUsuario" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Desactivar el usuario @u.NombreCompleto?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Desactivar">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" asp-route-id="@u.IdUsuario" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Activar">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="invoice-footer mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
        </a>
    </div>
</div>