@using FastBurger.Application.DTOs
@{
    ViewData["Title"] = "Resetear Contraseña";
    var usuario = ViewBag.Usuario as UsuarioListaDTO;
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <h2 class="mb-1 fw-bold">
            <i class="bi bi-key me-2"></i>Resetear Contraseña
        </h2>
        <p class="mb-0 invoice-subtitle">Cambiar la contraseña de @usuario?.NombreCompleto</p>
    </div>

    <form asp-action="ResetPassword" method="post" class="mt-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@usuario?.IdUsuario" />

        <div class="invoice-section">
            <div class="invoice-section-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                @if (usuario != null)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="info-label"><i class="bi bi-person me-1"></i>Usuario</label>
                            <input class="form-control" value="@usuario.NombreCompleto" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="info-label"><i class="bi bi-envelope me-1"></i>Correo</label>
                            <input class="form-control" value="@usuario.Correo" readonly />
                        </div>
                        <div class="col-md-12">
                            <label class="info-label"><i class="bi bi-lock me-1"></i>Nueva Contraseña</label>
                            <input name="nuevaContrasena" class="form-control" autocomplete="new-password" />
                        </div>
                        <div class="col-md-12">
                            <label class="info-label"><i class="bi bi-lock-fill me-1"></i>Confirmar Contraseña</label>
                            <input name="confirmarContrasena" class="form-control" autocomplete="new-password" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="invoice-footer mt-4">
            <button type="submit" class="btn btn-fb">
                <i class="bi bi-check-circle me-1"></i>Guardar Contraseña
            </button>
            <a asp-action="Index" class="btn btn-back ms-2">
                <i class="bi bi-arrow-left me-1"></i>Cancelar
            </a>
        </div>
    </form>
</div>