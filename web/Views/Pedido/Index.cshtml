@model IEnumerable<FastBurger.Application.DTOs.PedidoDTO>

@{
    ViewData["Title"] = (ViewBag.EsAdmin ? "Gestión de " : "Mi ") + "Historial de Pedidos";
    var info = ViewBag.UsuarioInfo as FastBurger.Application.DTOs.InfoUsuarioDTO;
    var esAdmin = (bool)(ViewBag.EsAdmin ?? false);
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-receipt me-2"></i>@(esAdmin ? "Gestión de Pedidos" : "Mi Historial de Pedidos")
                </h2>
                <p class="mb-0 invoice-subtitle">@(info != null ? $"{info.Nombre} {info.Apellidos} · {info.NombreRol}" : "—")</p>
            </div>
            <div class="text-end">
                <div class="invoice-number">@Model.Count() <small style="font-size: 0.6em; font-weight: 500;">pedido@(Model.Count() == 1 ? "" : "s")</small></div>
            </div>
        </div>
    </div>

    @if (esAdmin)
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filtros de Búsqueda</h5>
            </div>
            <div class="invoice-section-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label class="info-label"><i class="bi bi-person me-1"></i>Cliente</label>
                        <select name="filtroUsuarioId" class="form-select" asp-items="@(new SelectList(ViewBag.Clientes, "IdUsuario", "NombreCompleto"))">
                            <option value="">Todos los clientes</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="info-label"><i class="bi bi-flag me-1"></i>Estado</label>
                        <select name="estado" class="form-select">
                            <option value="">Todos</option>
                            <option value="pendiente_pago">Pendiente de pago</option>
                            <option value="aceptada">Aceptada</option>
                            <option value="preparacion">En preparación</option>
                            <option value="procesando">Procesando</option>
                            <option value="entregada">Entregada</option>
                            <option value="cancelada">Cancelada</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="info-label"><i class="bi bi-calendar me-1"></i>Desde</label>
                        <input type="date" name="fechaDesde" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="info-label"><i class="bi bi-calendar me-1"></i>Hasta</label>
                        <input type="date" name="fechaHasta" class="form-control" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-fb-primary me-2">
                            <i class="bi bi-search me-1"></i>Filtrar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Limpiar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-body text-center py-5">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3" style="color: #3D2B1F;">No hay pedidos registrados</h4>
                <p class="text-muted mb-0">Aún no se han registrado pedidos con los filtros actuales.</p>
            </div>
        </div>
    }
    else
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Listado de Pedidos</h5>
            </div>
            <div class="table-responsive">
                <table class="table invoice-table mb-0">
                    <thead>
                        <tr>
                            <th># Pedido</th>
                            @if (esAdmin)
                            {
                                <th>Cliente</th>
                            }
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th class="text-center">Artículos</th>
                            <th class="text-end">Total</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@pedido.IdPedido</td>
                                @if (esAdmin)
                                {
                                    <td>
                                        <div class="product-name">@pedido.NombreUsuario</div>
                                        <small class="text-muted">@pedido.CorreoUsuario</small>
                                    </td>
                                }
                                <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (pedido.TipoEntrega == "recoger")
                                    {
                                        <span class="badge bg-info"><i class="bi bi-bag-check me-1"></i>Recoger</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-truck me-1"></i>Domicilio</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="qty-badge">@pedido.TotalItems</span>
                                </td>
                                <td class="text-end fw-semibold">₡@pedido.Total.ToString("N2")</td>
                                <td>
                                    @{
                                        var estadoClass = pedido.Estado switch
                                        {
                                            "pendiente_pago" => "bg-secondary",
                                            "aceptada" => "bg-primary",
                                            "preparacion" => "bg-warning text-dark",
                                            "procesando" => "bg-info text-dark",
                                            "entregada" => "bg-success",
                                            "cancelada" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        var estadoTexto = pedido.Estado switch
                                        {
                                            "pendiente_pago" => "Pendiente de pago",
                                            "aceptada" => "Aceptada",
                                            "preparacion" => "En preparación",
                                            "procesando" => "Procesando",
                                            "entregada" => "Entregada",
                                            "cancelada" => "Cancelada",
                                            _ => pedido.Estado
                                        };
                                    }
                                    <span class="badge @estadoClass">@estadoTexto</span>
                                </td>
                                <td>
                                    <a asp-action="Detalle" asp-route-id="@pedido.IdPedido" class="btn btn-sm btn-fb">
                                        <i class="bi bi-eye me-1"></i>Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!esAdmin)
    {
        <div class="invoice-footer mt-4">
            <a asp-action="Registrar" class="btn btn-fb-primary">
                <i class="bi bi-plus-circle me-1"></i> Registrar Nuevo Pedido
            </a>
        </div>
    }
</div>