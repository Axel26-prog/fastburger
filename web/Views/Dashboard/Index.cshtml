@using FastBurger.Application.DTOs
@using System.Text.Json
@model DashboardDTO
@{
    ViewData["Title"] = "Tablero de Control";
    var top = Model.TopProductos;
    var estados = Model.PedidosPorEstado;
    var hayTop = top.Any();
    var hayEstados = estados.Any(e => e.Cantidad > 0);
}

<div class="invoice-wrapper">
    <div class="invoice-header text-white">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-graph-up me-2"></i>Tablero de Control
                </h2>
                <p class="mb-0 invoice-subtitle">Resumen del día @Model.Fecha.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="text-end">
                <span class="badge bg-light text-dark fs-6">@Model.TotalPedidosHoy pedidos hoy</span>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <!-- Top 3 productos -->
        <div class="col-lg-7">
            <div class="invoice-section">
                <div class="invoice-section-header">
                    <h5 class="mb-0"><i class="bi bi-trophy-fill me-2"></i>Top 3 productos más vendidos</h5>
                </div>
                <div class="invoice-section-body">
                    @if (hayTop)
                    {
                        <canvas id="chartTopProductos" height="220"></canvas>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-emoji-frown" style="font-size: 3rem;"></i>
                            <p class="mt-3 mb-0">Sin datos hoy</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Pedidos por estado -->
        <div class="col-lg-5">
            <div class="invoice-section">
                <div class="invoice-section-header">
                    <h5 class="mb-0"><i class="bi bi-pie-chart-fill me-2"></i>Pedidos por estado</h5>
                </div>
                <div class="invoice-section-body">
                    @if (hayEstados)
                    {
                        <canvas id="chartEstados" height="220"></canvas>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-emoji-frown" style="font-size: 3rem;"></i>
                            <p class="mt-3 mb-0">Sin datos hoy</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (hayTop)
    {
        <div class="invoice-section mt-4">
            <div class="invoice-section-header">
                <h5 class="mb-0"><i class="bi bi-list-ol me-2"></i>Detalle del ranking</h5>
            </div>
            <div class="table-responsive">
                <table class="table invoice-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Producto</th>
                            <th class="text-end">Unidades vendidas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < top.Count; i++)
                        {
                            var p = top[i];
                            <tr>
                                <td class="fw-bold">@(i + 1)</td>
                                <td class="product-name">@p.Nombre</td>
                                <td class="text-end fw-semibold">@p.CantidadVendida</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="invoice-footer mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-back">
            <i class="bi bi-arrow-left me-1"></i>Volver al Inicio
        </a>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        const topProductos = @Html.Raw(JsonSerializer.Serialize(top.Select(p => new { p.Nombre, p.CantidadVendida })));
        const pedidosPorEstado = @Html.Raw(JsonSerializer.Serialize(estados.Select(e => new { e.EstadoTexto, e.Cantidad })));

        const paleta = ['#c8102e', '#F4A261', '#2A9D8F', '#264653', '#E9C46A', '#6C757D'];

        @if (hayTop)
        {
            <text>
            new Chart(document.getElementById('chartTopProductos'), {
                type: 'bar',
                data: {
                    labels: topProductos.map(p => p.Nombre),
                    datasets: [{
                        label: 'Unidades vendidas',
                        data: topProductos.map(p => p.CantidadVendida),
                        backgroundColor: ['#c8102e', '#F4A261', '#E9C46A'],
                        borderWidth: 0
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { ticks: { font: { size: 13 } } } }
                }
            });
            </text>
        }

        @if (hayEstados)
        {
            <text>
            new Chart(document.getElementById('chartEstados'), {
                type: 'doughnut',
                data: {
                    labels: pedidosPorEstado.map(e => e.EstadoTexto),
                    datasets: [{
                        data: pedidosPorEstado.map(e => e.Cantidad),
                        backgroundColor: paleta,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom', labels: { font: { size: 12 }, padding: 12 } }
                    }
                }
            });
            </text>
        }
    </script>
}